version     = "0.1.0"
author      = "daveey"
description = "Negotiation Games: a three-seat bargaining table for the Softmax Coworld platform. Two cogs split a pool of books, hats and balls under private values; agree or both get zero. A policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
